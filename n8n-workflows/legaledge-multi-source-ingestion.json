{
  "name": "LegalEdge Multi-Source Data Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "@n8n/n8n-nodes-langchain.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "data_sources",
              "value": "[\"congress_gov\", \"state_portals\", \"sec_filings\", \"news_feeds\", \"market_data\"]"
            }
          ]
        }
      },
      "id": "set-data-sources",
      "name": "Set Data Sources",
      "type": "@n8n/n8n-nodes-langchain.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "functionCode": "return items.map(item => {\n  const sources = JSON.parse(item.json.data_sources);\n  return sources.map(source => ({ json: { data_source: source, timestamp: new Date().toISOString() } }));\n}).flat();"
      },
      "id": "split-data-sources",
      "name": "Split Data Sources",
      "type": "@n8n/n8n-nodes-langchain.function",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "field1": "={{ $json.data_source }}",
              "operation": "equals",
              "field2": "congress_gov"
            }
          ]
        }
      },
      "id": "route-congress-gov",
      "name": "Route Congress.gov Data",
      "type": "@n8n/n8n-nodes-langchain.if",
      "typeVersion": 1,
      "position": [960, 180]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "field1": "={{ $json.data_source }}",
              "operation": "equals",
              "field2": "state_portals"
            }
          ]
        }
      },
      "id": "route-state-portals",
      "name": "Route State Portals Data",
      "type": "@n8n/n8n-nodes-langchain.if",
      "typeVersion": 1,
      "position": [960, 420]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "field1": "={{ $json.data_source }}",
              "operation": "equals",
              "field2": "sec_filings"
            }
          ]
        }
      },
      "id": "route-sec-filings",
      "name": "Route SEC Filings Data",
      "type": "@n8n/n8n-nodes-langchain.if",
      "typeVersion": 1,
      "position": [960, 660]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "field1": "={{ $json.data_source }}",
              "operation": "equals",
              "field2": "news_feeds"
            }
          ]
        }
      },
      "id": "route-news-feeds",
      "name": "Route News Feeds Data",
      "type": "@n8n/n8n-nodes-langchain.if",
      "typeVersion": 1,
      "position": [960, 900]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "field1": "={{ $json.data_source }}",
              "operation": "equals",
              "field2": "market_data"
            }
          ]
        }
      },
      "id": "route-market-data",
      "name": "Route Market Data",
      "type": "@n8n/n8n-nodes-langchain.if",
      "typeVersion": 1,
      "position": [960, 1140]
    },
    {
      "parameters": {
        "url": "=https://api.congress.gov/v3/bill?api_key={{ $env.CONGRESS_API_KEY }}&limit=100",
        "responseMode": "responseBody",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-congress-data",
      "name": "Fetch Congress.gov Data",
      "type": "@n8n/n8n-nodes-langchain.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 180]
    },
    {
      "parameters": {
        "url": "=https://various-state-apis.gov/legislation?format=json",
        "responseMode": "responseBody",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-state-data",
      "name": "Fetch State Portals Data",
      "type": "@n8n/n8n-nodes-langchain.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "url": "=https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&output=atom",
        "responseMode": "responseBody",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-sec-data",
      "name": "Fetch SEC Filings Data",
      "type": "@n8n/n8n-nodes-langchain.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 660]
    },
    {
      "parameters": {
        "url": "=https://newsapi.org/v2/everything?q=legislation+OR+bills+OR+congress&apiKey={{ $env.NEWS_API_KEY }}&language=en&pageSize=100",
        "responseMode": "responseBody",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-news-data",
      "name": "Fetch News Feeds Data",
      "type": "@n8n/n8n-nodes-langchain.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 900]
    },
    {
      "parameters": {
        "url": "=https://api.marketdata.com/v1/news?symbols=*&token={{ $env.MARKET_DATA_TOKEN }}",
        "responseMode": "responseBody",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-market-data",
      "name": "Fetch Market Data",
      "type": "@n8n/n8n-nodes-langchain.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 1140]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    data_source: 'congress_gov',\n    records_count: items.length,\n    timestamp: new Date().toISOString(),\n    status: 'processed',\n    data: items\n  }\n}];"
      },
      "id": "process-congress-data",
      "name": "Process Congress Data",
      "type": "@n8n/n8n-nodes-langchain.function",
      "typeVersion": 1,
      "position": [1440, 180]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    data_source: 'state_portals',\n    records_count: items.length,\n    timestamp: new Date().toISOString(),\n    status: 'processed',\n    data: items\n  }\n}];"
      },
      "id": "process-state-data",
      "name": "Process State Data",
      "type": "@n8n/n8n-nodes-langchain.function",
      "typeVersion": 1,
      "position": [1440, 420]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    data_source: 'sec_filings',\n    records_count: items.length,\n    timestamp: new Date().toISOString(),\n    status: 'processed',\n    data: items\n  }\n}];"
      },
      "id": "process-sec-data",
      "name": "Process SEC Data",
      "type": "@n8n/n8n-nodes-langchain.function",
      "typeVersion": 1,
      "position": [1440, 660]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    data_source: 'news_feeds',\n    records_count: items.length,\n    timestamp: new Date().toISOString(),\n    status: 'processed',\n    data: items\n  }\n}];"
      },
      "id": "process-news-data",
      "name": "Process News Data",
      "type": "@n8n/n8n-nodes-langchain.function",
      "typeVersion": 1,
      "position": [1440, 900]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    data_source: 'market_data',\n    records_count: items.length,\n    timestamp: new Date().toISOString(),\n    status: 'processed',\n    data: items\n  }\n}];"
      },
      "id": "process-market-data",
      "name": "Process Market Data",
      "type": "@n8n/n8n-nodes-langchain.function",
      "typeVersion": 1,
      "position": [1440, 1140]
    },
    {
      "parameters": {
        "mode": "mergeByPosition"
      },
      "id": "merge-all-data",
      "name": "Merge All Data",
      "type": "@n8n/n8n-nodes-langchain.merge",
      "typeVersion": 2.1,
      "position": [1680, 600]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ingestion/batch",
        "responseMode": "responseBody",
        "options": {
          "bodyContentType": "json"
        },
        "bodyParameters": {
          "data": "={{ $json }}"
        }
      },
      "id": "send-to-legaledge",
      "name": "Send to LegalEdge API",
      "type": "@n8n/n8n-nodes-langchain.httpRequest",
      "typeVersion": 4.1,
      "position": [1920, 600]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "field1": "={{ $json.statusCode }}",
              "operation": "notEqual",
              "field2": 200
            }
          ]
        }
      },
      "id": "check-api-response",
      "name": "Check API Response",
      "type": "@n8n/n8n-nodes-langchain.if",
      "typeVersion": 1,
      "position": [2160, 600]
    },
    {
      "parameters": {
        "webhookUri": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
        "text": "=🚨 LegalEdge Ingestion Error\n\n❌ API Error\n⏰ Time: {{ $now.format('YYYY-MM-DD HH:mm:ss') }}\n🔍 Status Code: {{ $json.statusCode }}\n📝 Response: {{ $json.body }}\n\nData ingestion may have failed. Please check the LegalEdge backend logs."
      },
      "id": "slack-error-notification",
      "name": "Slack Error Notification",
      "type": "@n8n/n8n-nodes-langchain.slack",
      "typeVersion": 1,
      "position": [2400, 720]
    },
    {
      "parameters": {
        "webhookUri": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
        "text": "=✅ LegalEdge Data Ingestion Complete\n\n📊 Ingestion Summary\n⏰ Time: {{ $now.format('YYYY-MM-DD HH:mm:ss') }}\n🔄 Data Sources: {{ $json.data_sources || 'Multiple' }}\n📈 Records Processed: {{ $json.total_records || 'N/A' }}\n✅ Status: Success"
      },
      "id": "slack-success-notification",
      "name": "Slack Success Notification",
      "type": "@n8n/n8n-nodes-langchain.slack",
      "typeVersion": 1,
      "position": [2400, 480]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Set Data Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Data Sources": {
      "main": [
        [
          {
            "node": "Split Data Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Data Sources": {
      "main": [
        [
          {
            "node": "Route Congress.gov Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route State Portals Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route SEC Filings Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route News Feeds Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route Market Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Congress.gov Data": {
      "main": [
        [
          {
            "node": "Fetch Congress.gov Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route State Portals Data": {
      "main": [
        [
          {
            "node": "Fetch State Portals Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route SEC Filings Data": {
      "main": [
        [
          {
            "node": "Fetch SEC Filings Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route News Feeds Data": {
      "main": [
        [
          {
            "node": "Fetch News Feeds Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Market Data": {
      "main": [
        [
          {
            "node": "Fetch Market Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Congress.gov Data": {
      "main": [
        [
          {
            "node": "Process Congress Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch State Portals Data": {
      "main": [
        [
          {
            "node": "Process State Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch SEC Filings Data": {
      "main": [
        [
          {
            "node": "Process SEC Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch News Feeds Data": {
      "main": [
        [
          {
            "node": "Process News Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Market Data": {
      "main": [
        [
          {
            "node": "Process Market Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Congress Data": {
      "main": [
        [
          {
            "node": "Merge All Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process State Data": {
      "main": [
        [
          {
            "node": "Merge All Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Process SEC Data": {
      "main": [
        [
          {
            "node": "Merge All Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Process News Data": {
      "main": [
        [
          {
            "node": "Merge All Data",
            "type": "main",
            "index": 3
          }
        ]
      ]
    },
    "Process Market Data": {
      "main": [
        [
          {
            "node": "Merge All Data",
            "type": "main",
            "index": 4
          }
        ]
      ]
    },
    "Merge All Data": {
      "main": [
        [
          {
            "node": "Send to LegalEdge API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to LegalEdge API": {
      "main": [
        [
          {
            "node": "Check API Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check API Response": {
      "main": [
        [
          {
            "node": "Slack Error Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack Success Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "instanceId": "n8n-instance-id"
  },
  "id": "legaledge-multi-source-ingestion",
  "tags": [
    {
      "name": "LegalEdge",
      "id": "legaledge"
    },
    {
      "name": "Multi-Source",
      "id": "multi-source"
    },
    {
      "name": "Data Ingestion",
      "id": "data-ingestion"
    }
  ]
}
