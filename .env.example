# LegalEdge Platform Environment Configuration

# Application Settings
LEGALEDGE_APP_NAME="LegalEdge Platform"
LEGALEDGE_API_V1_PREFIX="/api/v1"
LEGALEDGE_ENVIRONMENT="development"

# Database Configuration
LEGALEDGE_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/legaledge"
LEGALEDGE_SYNC_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/legaledge"

# Redis Configuration
LEGALEDGE_REDIS_URL="redis://localhost:6379/0"

# Task Scheduling (in minutes)
LEGALEDGE_INGESTION_SCHEDULE_MINUTES=30
LEGALEDGE_MODEL_RETRAIN_SCHEDULE_MINUTES=360
LEGALEDGE_FORECAST_RETRAIN_SCHEDULE_MINUTES=240

# AI/ML Configuration
LEGALEDGE_OPENAI_API_KEY="your-openai-api-key-here"

# Celery Configuration
LEGALEDGE_CELERY_BROKER_URL="redis://localhost:6379/0"
LEGALEDGE_CELERY_RESULT_BACKEND="redis://localhost:6379/0"
LEGALEDGE_WORKER_CONCURRENCY=4

# Authentication & Security
LEGALEDGE_SECRET_KEY="your-secret-key-here"
LEGALEDGE_JWT_SECRET_KEY="your-jwt-secret-key-here"
LEGALEDGE_JWT_ALGORITHM="HS256"
LEGALEDGE_JWT_EXPIRATION_HOURS=24

# External APIs
LEGALEDGE_CONGRESS_API_KEY="your-congress-api-key-here"
LEGALEDGE_NEWS_API_KEY="your-news-api-key-here"
LEGALEDGE_MARKET_DATA_API_KEY="your-market-data-api-key-here"

# AWS Configuration (for production)
LEGALEDGE_AWS_REGION="us-east-1"
LEGALEDGE_AWS_ACCESS_KEY_ID="your-aws-access-key-id"
LEGALEDGE_AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Monitoring & Logging
LEGALEDGE_LOG_LEVEL="INFO"
LEGALEDGE_SENTRY_DSN="your-sentry-dsn-here"
LEGALEDGE_DATADOG_API_KEY="your-datadog-api-key-here"

# Email Configuration (for alerts)
LEGALEDGE_SMTP_HOST="smtp.gmail.com"
LEGALEDGE_SMTP_PORT=587
LEGALEDGE_SMTP_USER="your-email@gmail.com"
LEGALEDGE_SMTP_PASSWORD="your-email-password"
LEGALEDGE_EMAIL_FROM="noreply@legaledge.com"

# Frontend Configuration
LEGALEDGE_FRONTEND_URL="http://localhost:5173"
